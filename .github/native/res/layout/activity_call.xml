<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen">

    <!-- Native banner ad at the top of the call screen -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/call_ad_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-3940256099942544/6300978111" />

    <LinearLayout
        android:id="@+id/call_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="28dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEURACHAT CALL"
            android:textColor="#6600D4FF"
            android:textSize="10sp"
            android:letterSpacing="0.28"
            android:textStyle="bold" />

        <!-- Circular avatar with ring -->
        <FrameLayout
            android:id="@+id/call_avatar_wrap"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_call_avatar">

            <ImageView
                android:id="@+id/call_avatar_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/call_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="?"
                android:textColor="#00D4FF"
                android:textSize="52sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/call_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Unknown"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/call_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="#71717A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/call_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Incoming call"
            android:textColor="#00D4FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ACTIVE: 5 rounded tiles row -->
        <LinearLayout
            android:id="@+id/call_active_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/call_btn_mute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_call_tile"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_call_mic"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Mute"
                        android:textColor="#D4D4D8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/call_btn_speaker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_call_tile"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_call_speaker"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Speaker"
                        android:textColor="#D4D4D8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/call_btn_hold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_call_tile"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_call_hold"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Hold"
                        android:textColor="#D4D4D8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/call_btn_keypad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_call_tile"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_call_keypad"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Keypad"
                        android:textColor="#D4D4D8"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Red circular End button -->
            <FrameLayout
                android:id="@+id/call_btn_end"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_end_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_call_phone_down"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- INCOMING: circular decline + accept side by side -->
        <LinearLayout
            android:id="@+id/call_incoming_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="18dp">

                <FrameLayout
                    android:id="@+id/call_btn_dismiss"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/bg_call_decline_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_call_phone_down"
                        android:tint="#FFFFFF" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/call_btn_attend"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="40dp"
                    android:background="@drawable/bg_call_accept_circle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_call_phone_up"
                        android:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/call_btn_snooze"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:background="@drawable/bg_call_btn_snooze"
                android:gravity="center"
                android:text="Snooze 5 min"
                android:textColor="#E4E4E7"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- NUMPAD OVERLAY -->
    <LinearLayout
        android:id="@+id/call_numpad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F2000000"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEURACHAT CALL"
            android:textColor="#6600D4FF"
            android:textSize="10sp"
            android:letterSpacing="0.25"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/call_numpad_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/call_numpad_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:minHeight="56dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/np_1" style="@style/CallNumpadKey" android:text="1" />
            <TextView android:id="@+id/np_2" style="@style/CallNumpadKey" android:text="2" />
            <TextView android:id="@+id/np_3" style="@style/CallNumpadKey" android:text="3" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
            <TextView android:id="@+id/np_4" style="@style/CallNumpadKey" android:text="4" />
            <TextView android:id="@+id/np_5" style="@style/CallNumpadKey" android:text="5" />
            <TextView android:id="@+id/np_6" style="@style/CallNumpadKey" android:text="6" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
            <TextView android:id="@+id/np_7" style="@style/CallNumpadKey" android:text="7" />
            <TextView android:id="@+id/np_8" style="@style/CallNumpadKey" android:text="8" />
            <TextView android:id="@+id/np_9" style="@style/CallNumpadKey" android:text="9" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
            <TextView android:id="@+id/np_star" style="@style/CallNumpadKey" android:text="*" />
            <TextView android:id="@+id/np_0" style="@style/CallNumpadKey" android:text="0" />
            <TextView android:id="@+id/np_hash" style="@style/CallNumpadKey" android:text="#" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/call_numpad_backspace"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:padding="14dp"
                android:src="@drawable/ic_call_backspace"
                android:tint="#E4E4E7"
                android:scaleType="centerInside" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/call_numpad_back"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_call_chevron_down"
                    android:tint="#E4E4E7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:textColor="#E4E4E7"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
